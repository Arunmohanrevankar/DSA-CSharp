using System;
class DSA
{
    public static void Main()
    {
        int[] arr = { 10, 20, 30, 20, 40, 30,20 };
        for (int i = 0; i < arr.Length; i++)
        {
            for (int j = i + 1; j < arr.Length; j++)
            {
                if (arr[i] == arr[j])
                {
                    Console.WriteLine("First duplicate: " + arr[i]);
                    return;
                }
            }
        }
        Console.WriteLine("No duplicate found");
    }
}
