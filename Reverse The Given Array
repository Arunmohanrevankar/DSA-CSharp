using System;

public class DSA
{
    public static void Main(string[] args)
    {
        int[] Array = { 40, 3, 1, 78, 98 };
        Console.WriteLine("The Original Array is : {" + String.Join(",",Array)+"}");
        int Left = 0;
        int Right = Array.Length -1;
        while (Left != Right)
        {
            int Temp = Array[Left];
            Array[Left] = Array[Right];
            Array[Right] = Temp;
            Left++;
            Right--;
        }
        Console.WriteLine("The Reversed Array is : {" + String.Join(",",Array)+"}");
    }
}
