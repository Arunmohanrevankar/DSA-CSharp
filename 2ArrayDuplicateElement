using System;
public class DSA
{
    public static void Main(string[] args)
    {
        int[] Array = { 40, 3, 1, 3, 98,1 };
        Console.WriteLine("The Original Array is : {" + String.Join(",", Array) + "}");
        for (int i = 0; i < Array.Length - 1; i++)
        {
            for (int j =i+1; j < Array.Length; j++)
            {
                if (Array[i] == Array[j])
                {
                    Console.WriteLine("Duplicate in Array : "+Array[i]);
                }
            }
        }
    }
}
