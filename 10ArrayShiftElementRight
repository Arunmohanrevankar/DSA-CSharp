//Right Shift
using System;
public class DSA
{
    public static void Main(string[] args)
    {
        int[] Array = { 40, 3, 1, 78, 98 };
        Console.WriteLine("The Given Array : {"+String.Join(",",Array)+"}");
        int Move = Array[2];
        for (int i = 0; i < Array.Length; i++)
        {
            if (Array[i] == Move)
            {
                for (int j = i; j > 0; j--)
                {
                    Array[j] = Array[j - 1];
                }
                Array[0] = Move;
                break;
            }
        }
        Console.WriteLine("The Modified Array : {"+String.Join(", ", Array)+"}");
    }
}
