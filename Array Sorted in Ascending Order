using System;

public class DSA
{
    public static void Main(string[] args)
    {
        int[] Array = { 40, 3, 1, 78, 98 };

        Console.WriteLine(
            "The Original Array is : {" + String.Join(",", Array) + "}"
        );

        for (int i = 0; i < Array.Length - 1; i++)
        {
            for (int j = 0; j < Array.Length - 1 - i; j++)
            {
                if (Array[j] > Array[j + 1])
                {
                    int Temp = Array[j];
                    Array[j] = Array[j + 1];
                    Array[j + 1] = Temp;
                }
            }
        }

        Console.WriteLine(
            "The Sorted Array in Ascending : {" + String.Join(",", Array) + "}"
        );
    }
}
