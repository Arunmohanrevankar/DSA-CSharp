using System;
public class DSA
{
    public static void Main(string[] args)
    {
       int[] Array = {40,3,1,78,98} ;
       Console.WriteLine("The Given Array : {"+String.Join(",",Array)+"}");
       int Small = Array[0];
       foreach (int element in Array)
       {
           if (element < Small)
           Small = element;
       }
       Console.WriteLine("The Smallest in Array is : "+Small);
    }
}
