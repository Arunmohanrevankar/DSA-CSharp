using System;

public class DSA
{
    public static void Main(string[] args)
    {
        int[] Array = { 40, 3, 1, 78, 98 };

        int Small = Array[0];
        int SecondSmall = Array[0];

        foreach (int element in Array)
        {
            if (element < Small)
            {
                SecondSmall = Small;
                Small = element;
            }
            else if (element < SecondSmall && element != Small)
            {
                SecondSmall = element;
            }
        }
        Console.WriteLine("The Smallest in Array is : " + Small);
        Console.WriteLine("The Second Smallest in Array is : " + SecondSmall);
    }
}
